// Lab Management System - database schema (MySQL 8, InnoDB, utf8mb4).
// Paste into https://dbdiagram.io (or Import > DBML). Generated by: python -m tools.generate_dbml
// All datetimes are UTC. Every table also has the id / created_at / updated_at columns shown below.

Project lab_management {
  database_type: 'MySQL'
  Note: 'LAN-based laboratory management system with an integrated Python coding environment'
}

Enum enrollments_status {
  pending
  approved
  rejected
  removed
}

Enum executions_kind {
  run
  test
  grade
}

Enum executions_mode {
  interactive
  batch
}

Enum executions_status {
  queued
  running
  ok
  error
  timeout
  memory_exceeded
  output_limit
  system_error
  stopped
  input_timeout
}

Enum login_events_outcome {
  success
  replaced_other_session
}

Enum storage_limits_role {
  admin
  instructor
  student
}

Enum submissions_status {
  submitted
  late
}

Enum test_cases_match_mode {
  trim
  exact
  ignore_case
  contains
}

Enum users_role {
  admin
  instructor
  student
}

Table labs {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Note: 'A computer lab: a named room. Lab sessions book it (no two sessions of a lab may overlap).'
}

Table tutorial_lessons {
  id bigint [pk, increment]
  slug varchar(60) [not null, unique]
  title varchar(150) [not null]
  sort_order integer [not null, default: 0]
  summary varchar(300) [not null, default: '']
  body_md mediumtext [not null]
  examples json [not null, note: 'JSON list of {title, code}']
  exercise json [not null, note: 'prompt, starter_code, starter_files, entry, ignore_input_prompts, tests, reference_solution. The reference solution and hidden tests never reach students']
  is_hidden boolean [not null, default: false]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Note: 'The built-in Python tutorial. Loaded from content/tutorial/*.md (python -m app.tutorial_content), editable afterwards; Reset to default reloads the file.'
}

Table users {
  id bigint [pk, increment]
  username varchar(64) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  student_no varchar(32) [unique]
  role users_role [not null]
  admin_flag smallint [note: 'generated: 1 for the administrator, NULL for everyone else; its unique key allows only one administrator']
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: false, note: 'true after an admin reset or a CSV import: only /auth/me, change-password and logout work until the password is changed']
  preferences json [note: 'own settings of the user (theme, editor_theme); missing values mean the defaults']
  storage_max_file_bytes integer [note: 'own limit of this user; NULL = the limit of the role (storage_limits)']
  storage_max_workspace_bytes integer [note: 'own limit of this user, per workspace; NULL = the limit of the role (storage_limits)']
  storage_max_files integer [note: 'own limit of this user, per workspace; NULL = the limit of the role (storage_limits)']
  current_session_id varchar(64) [note: 'random id of the latest login; NULL after logout']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Note: 'Every account. current_session_id holds the latest login; a token carrying an older id is rejected (one device per account).'
}

Table activity_logs {
  id bigint [pk, increment]
  user_id bigint
  action varchar(64) [not null]
  details json
  ip_address varchar(45)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    (user_id, created_at) [name: 'ix_activity_logs_user_created']
  }

  Note: 'Audit trail. user_id is NULL for events with no known user (e.g. a failed sign-up). Never holds passwords, tokens, codes or student code.'
}

Table classes {
  id bigint [pk, increment]
  instructor_id bigint [not null]
  name varchar(150) [not null]
  year_and_section varchar(50) [not null]
  school_year varchar(20) [not null]
  is_archived boolean [not null, default: false]
  tutorial_unlock_in_order boolean [not null, default: false, note: 'the tutorial opens one lesson at a time for this class (a lesson needs the previous one passed)']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
}

Table registration_codes {
  id bigint [pk, increment]
  code_hash varchar(64) [not null, unique, note: 'SHA-256 hex of the 10-character code; the plaintext is never stored']
  code_hint varchar(4) [not null, note: 'last 4 characters of the code, for display']
  batch_name varchar(100) [not null]
  student_no varchar(32) [note: 'if set, the code only works for this student number']
  full_name varchar(150) [note: 'prefilled name for single codes; becomes the full name of the new account']
  expires_at datetime(6)
  created_by bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    batch_name [name: 'ix_registration_codes_batch_name']
    expires_at [name: 'ix_registration_codes_expires_at']
  }

  Note: 'Unused one-time student sign-up codes. Only the SHA-256 of a code is stored; the row is deleted when the code is used.'
}

Table storage_limits {
  role storage_limits_role [pk]
  max_file_bytes integer [not null]
  max_workspace_bytes integer [not null]
  max_files integer [not null]
  updated_at datetime(6)
  updated_by bigint [note: 'the admin who last changed them']

  Note: 'Workspace storage limits of a role (student, instructor), set by an admin; they apply to each workspace of a user. No row = the built-in defaults (100 KB per file, 2 MB, 100 files). users.storage_* override them per user.'
}

Table tutorial_progress {
  id bigint [pk, increment]
  student_id bigint [not null]
  lesson_id bigint [not null]
  viewed_at datetime(6)
  passed_at datetime(6) [note: 'the first time every test of the exercise passed']
  attempts integer [not null, default: 0]
  last_code mediumtext
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    (student_id, lesson_id) [unique, name: 'uq_tutorial_progress']
  }

  Note: 'One row per student and lesson: first view, first all-pass, number of checks, autosaved code.'
}

Table activities {
  id bigint [pk, increment]
  class_id bigint [not null]
  title varchar(150) [not null]
  instructions text
  starter_files json [note: 'JSON list of {path, content}, relative to the activity folder']
  due_at datetime(6)
  is_published boolean [not null, default: false]
  is_archived boolean [not null, default: false, note: 'published activities only: hidden from students, folder read-only, submissions and grades kept']
  entry_file varchar(255) [not null, default: 'main.py', note: 'the program graded for this activity, relative to the activity folder']
  ignore_input_prompts boolean [not null, default: true, note: 'true = the text passed to input() is left out of the output being compared']
  requirements json [note: 'code requirements checked with ast before the tests run: must_define_functions, must_use, must_not_use_calls, must_not_use_imports; NULL = none']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
}

Table invite_codes {
  id bigint [pk, increment]
  class_id bigint [not null]
  code varchar(8) [not null, unique]
  valid_from datetime(6) [not null]
  valid_until datetime(6) [not null]
  is_active boolean [not null, default: true]
  max_uses integer [note: 'NULL = unlimited']
  use_count integer [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
}

Table lab_sessions {
  id bigint [pk, increment]
  class_id bigint [not null]
  name varchar(100) [not null, note: 'one meeting of the class, e.g. Week 3 (was batch_name)']
  starts_at datetime(6) [not null]
  ends_at datetime(6) [not null]
  is_open boolean [not null, default: false]
  opened_at datetime(6) [note: 'by the instructor (from 15 minutes before starts_at) or by the scheduler at starts_at; NULL = not opened yet']
  closed_at datetime(6) [note: 'by the instructor, or by the scheduler at ends_at']
  lab_id bigint [note: 'the room it books (required by the API; no two sessions of a lab may overlap). NULL only when the lab was deleted after the session ended']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Note: 'A weekly lab meeting of a class in a lab. It opens itself at starts_at and closes itself at ends_at (Celery beat, every 15 s); the instructor may open it from 15 minutes before and close it any time.'
}

Table workspaces {
  id bigint [pk, increment]
  student_id bigint [not null]
  class_id bigint [note: 'NULL = personal Practice workspace']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    (student_id, class_id) [unique, name: 'uq_workspaces_student_class']
  }

  Note: 'Files of one user (a student, or an instructor for Practice). class_id NULL = the personal Practice workspace of that user (one per user, enforced in the service because MySQL allows many NULLs in a unique key).'
}

Table enrollments {
  id bigint [pk, increment]
  class_id bigint [not null]
  student_id bigint [not null]
  status enrollments_status [not null, default: 'pending']
  invite_code_id bigint [note: 'the invite code the student joined with']
  reviewed_by bigint
  reviewed_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    (class_id, student_id) [unique, name: 'uq_enrollments_class_student']
    (class_id, status) [name: 'ix_enrollments_class_status']
  }

  Note: 'Membership of a student in a class: pending until the instructor approves.'
}

Table executions {
  id bigint [pk, increment]
  student_id bigint [not null]
  workspace_id bigint [note: 'the workspace that was run (a class workspace or the Practice workspace)']
  activity_id bigint [note: 'set when the entry file is inside a published activity folder']
  lab_session_id bigint [note: 'NULL for Practice runs']
  entry_path varchar(255) [not null]
  stdin text [note: 'batch: the input given up front. interactive: every line the student typed, joined with newlines']
  output mediumtext
  exit_code integer
  status executions_status [not null, default: 'queued']
  duration_ms integer
  kind executions_kind [not null, default: 'run']
  mode executions_mode [not null, default: 'batch', note: 'interactive = the program pauses at input() and the student types live; batch = all input given up front']
  tutorial_lesson_id bigint [note: 'set for a tutorial exercise check: the lesson whose tests ran']
  test_results json [note: 'JSON list per test case: case_id, passed, points_awarded, status, duration_ms, actual_output (max 4 KB)']
  queued_at datetime(6)
  started_at datetime(6)
  finished_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    status [name: 'ix_executions_status']
    (student_id, created_at) [name: 'ix_executions_student_created']
  }

  Note: 'Every Run, test and grading job (kind). lab_session_id and activity_id are NULL for Practice runs; workspace_id is NULL for an instructor trying a test case.'
}

Table login_events {
  id bigint [pk, increment]
  user_id bigint [not null]
  user_agent varchar(255)
  lab_session_id bigint
  outcome login_events_outcome [not null]
  created_at datetime(6) [not null]

  indexes {
    (lab_session_id, created_at) [name: 'ix_login_events_session_created']
    (user_id, created_at) [name: 'ix_login_events_user_created']
  }

  Note: 'Every sign-in, with the lab session of the student (if one of their classes had one open) and its outcome: success, or replaced_other_session when it signed another session of the account out. Addresses are in the audit log only.'
}

Table session_activity_starts {
  id bigint [pk, increment]
  lab_session_id bigint [not null]
  student_id bigint [not null]
  activity_id bigint [not null]
  started_at datetime(6) [not null]

  indexes {
    (lab_session_id, student_id, activity_id) [unique, name: 'uq_session_activity_starts']
  }

  Note: 'When a student first opened a file inside an activity folder during a lab session.'
}

Table session_starts {
  id bigint [pk, increment]
  lab_session_id bigint [not null]
  student_id bigint [not null]
  started_at datetime(6) [not null]
  first_activity_id bigint [note: 'the first activity they opened a file of in that session; NULL until they do']

  indexes {
    (lab_session_id, student_id) [unique, name: 'uq_session_starts']
  }

  Note: 'When a student started in a lab session: their first class-workspace access (file tree or a file opened) while it was open. Written once.'
}

Table submissions {
  id bigint [pk, increment]
  activity_id bigint [not null]
  student_id bigint [not null]
  submitted_at datetime(6) [not null]
  status submissions_status [not null]
  tests_passed integer
  tests_total integer
  score integer
  max_score integer
  graded_at datetime(6)
  hardcode_suspected boolean [not null, default: false, note: 'set by grading: a string literal in the code holds an expected-output line of a hidden case (instructor only, no automatic fail)']
  hardcode_tests json [note: 'names of those hidden cases']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    (activity_id, student_id) [unique, name: 'uq_submissions_activity_student']
  }

  Note: 'One row per (activity, student); resubmitting replaces the snapshot and clears the score until it is graded again.'
}

Table test_cases {
  id bigint [pk, increment]
  activity_id bigint [not null]
  name varchar(150) [not null]
  stdin text
  expected_output text [note: 'compared by the worker only; never sent to the sandbox, never shown to students for hidden cases']
  is_hidden boolean [not null, default: false]
  points integer [not null, default: 1]
  match_mode test_cases_match_mode [not null, default: 'trim', note: 'trim (default) / exact / ignore_case / contains']
  sort_order integer [not null, default: 0]
  require_input_read boolean [not null, default: true, note: 'with stdin: the case passes only if the program read every input line (counted by the sandbox, outside the program)']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    (activity_id, sort_order) [name: 'ix_test_cases_activity_sort']
  }

  Note: 'Automatic checks of an activity: run the program with stdin and compare the output with expected_output. Hidden cases are never shown to students.'
}

Table workspace_files {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  path varchar(255) [not null]
  is_folder boolean [not null, default: false]
  content mediumtext
  size_bytes integer [not null, default: 0, note: 'UTF-8 size of content; counted against the 100 KB file and 2 MB workspace limits']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    (workspace_id, path) [unique, name: 'uq_workspace_files_workspace_path']
  }

  Note: 'Files and folders (is_folder). Paths are unique within a workspace and never start with a dot or contain dot-dot.'
}

Table file_versions {
  id bigint [pk, increment]
  file_id bigint [not null]
  content mediumtext
  saved_at datetime(6) [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    file_id [name: 'ix_file_versions_file_id']
  }

  Note: 'History of manual saves only; the newest 20 per file are kept.'
}

Table submission_files {
  id bigint [pk, increment]
  submission_id bigint [not null]
  path varchar(255) [not null]
  content mediumtext
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  indexes {
    submission_id [name: 'ix_submission_files_submission_id']
  }

  Note: 'Frozen copy of the activity folder at submit time.'
}

Ref: activity_logs.user_id > users.id [delete: set null]
Ref: classes.instructor_id > users.id
Ref: registration_codes.created_by > users.id
Ref: storage_limits.updated_by > users.id [delete: set null]
Ref: tutorial_progress.lesson_id > tutorial_lessons.id [delete: cascade]
Ref: tutorial_progress.student_id > users.id [delete: cascade]
Ref: activities.class_id > classes.id
Ref: invite_codes.class_id > classes.id
Ref: lab_sessions.class_id > classes.id
Ref: lab_sessions.lab_id > labs.id [delete: set null]
Ref: workspaces.class_id > classes.id
Ref: workspaces.student_id > users.id
Ref: enrollments.class_id > classes.id
Ref: enrollments.invite_code_id > invite_codes.id
Ref: enrollments.reviewed_by > users.id
Ref: enrollments.student_id > users.id
Ref: executions.activity_id > activities.id [delete: set null]
Ref: executions.lab_session_id > lab_sessions.id [delete: set null]
Ref: executions.student_id > users.id
Ref: executions.tutorial_lesson_id > tutorial_lessons.id [delete: set null]
Ref: executions.workspace_id > workspaces.id
Ref: login_events.lab_session_id > lab_sessions.id [delete: set null]
Ref: login_events.user_id > users.id [delete: cascade]
Ref: session_activity_starts.activity_id > activities.id [delete: cascade]
Ref: session_activity_starts.lab_session_id > lab_sessions.id [delete: cascade]
Ref: session_activity_starts.student_id > users.id [delete: cascade]
Ref: session_starts.first_activity_id > activities.id [delete: set null]
Ref: session_starts.lab_session_id > lab_sessions.id [delete: cascade]
Ref: session_starts.student_id > users.id [delete: cascade]
Ref: submissions.activity_id > activities.id
Ref: submissions.student_id > users.id
Ref: test_cases.activity_id > activities.id [delete: cascade]
Ref: workspace_files.workspace_id > workspaces.id [delete: cascade]
Ref: file_versions.file_id > workspace_files.id [delete: cascade]
Ref: submission_files.submission_id > submissions.id [delete: cascade]

TableGroup Accounts_and_access {
  users
  registration_codes
  activity_logs
  storage_limits
}

TableGroup Classes_and_labs {
  classes
  invite_codes
  enrollments
  lab_sessions
  session_starts
  session_activity_starts
  activities
  test_cases
}

TableGroup Files_and_workspaces {
  workspaces
  workspace_files
  file_versions
}

TableGroup Work_and_runs {
  submissions
  submission_files
  executions
}

TableGroup Labs_and_sign_ins {
  labs
  login_events
}

TableGroup Tutorial {
  tutorial_lessons
  tutorial_progress
}
