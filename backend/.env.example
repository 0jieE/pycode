# Copy to .env and change every value marked CHANGE-ME. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# MySQL (the compose service is called "mysql")
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=lab
MYSQL_USER=lab
MYSQL_PASSWORD=CHANGE-ME
MYSQL_ROOT_PASSWORD=CHANGE-ME

# Redis (the compose service is called "redis")
REDIS_URL=redis://redis:6379/0

# Auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# Celery / sandbox
# Parallel sandbox runs (the code default is 6). The sandbox alone peaked at ~6.4 runs/s with 10 workers and stayed
# flat at 12 (8 workers: 5.2 runs/s) on a Docker Desktop host. Tune it on the real server
# with `docker compose exec worker python -m loadtest.bench_sandbox --sweep`: stop where runs/s stops improving.
CELERY_CONCURRENCY=12

# Practice runs (students' personal workspace) use their own queue and worker, so they can never slow down a
# lab: this is how many practice runs execute at once.
PRACTICE_CONCURRENCY=2

# Interactive runs (programs that wait for the student to type at input()) use their own queue and a thread-pool
# worker: this is how many can be open at once. Waiting costs no CPU, only a container's idle memory.
INTERACTIVE_CONCURRENCY=40

# The only peer whose X-Real-IP / X-Forwarded-For is believed: Nginx's fixed address in docker-compose.yml.
# Change both together if that subnet clashes with your LAN.
TRUSTED_PROXY_IPS=172.28.0.10
# Host port Nginx listens on (use 80 on the LAN server)
NGINX_PORT=80
